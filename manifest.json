{
  "manifest_version": 3,
  "name": "Tool Bar Clock - Fork Version",
  "version": "1.0",
  "description": "Display a clock on the toolbar. Forked from the Tool Bar Clock Firefox add-on.",
  "homepage_url": "https://github.com/candywater/Tool-Bar-Clock-Firefox",
  "icons": {
    "48": "icon.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Tool Bar Clock",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tool-bar-clock-fork-version@example.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}